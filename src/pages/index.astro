---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Callout from '../components/Callout.astro';
import { city, services, neighborhoods } from '../data/city';
import { faqSchema } from '../lib/seo';
import { u } from '../lib/utils';
const home = city.home;
const icons: Record<string, string> = {
  drop: '<path d="M12 2.5c3.4 4.2 6 7.4 6 10.9A6 6 0 0 1 6 13.4c0-3.5 2.6-6.7 6-10.9Z"/>',
  leaf: '<path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 15l-1 0zM5 19l7-7" fill="none" stroke="currentColor" stroke-width="2"/>',
  repeat: '<path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" fill="none" stroke="currentColor" stroke-width="2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5" fill="none" stroke="currentColor" stroke-width="2"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z" fill="none" stroke="currentColor" stroke-width="2"/>',
};
const steps = home.steps;
---
<Base title={home.title} description={home.desc} path="/" extraSchema={[faqSchema(home.faqs)]}>
  <Hero headline={home.h1} intro={home.intro} location="Homepage" />
  <section class="sec sec-low"><div class="sec-in">
    <span class="sec-kicker">Choosing a method</span>
    <h2 class="sec-title">{home.compareTitle}</h2>
    <p class="sec-lead">{home.compareLead}</p>
    <div class="cmp">
      <article class="cmp-card"><h3>{home.compareJettingH}</h3>
        <p set:html={home.compareJettingP1} />
        <p>{home.compareJettingP2}</p></article>
      <article class="cmp-card"><h3>{home.compareRoddingH}</h3>
        <p>{home.compareRoddingP1}</p>
        <p>{home.compareRoddingP2}</p></article>
    </div>
  </div></section>
  <section class="sec sec-cream"><div class="sec-in">
    <span class="sec-kicker">Services</span>
    <h2 class="sec-title">{home.servicesTitle}</h2>
    <p class="sec-lead">{home.servicesLead}</p>
    <div class="svc-grid">{services.map((s) => <a class="svc" href={u(`/services/${s.slug}/`)}><span class="svc-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.icon]} /></span><span class="eb">Service</span><h3>{s.name}</h3><p>{s.blurb}</p><span class="arrow">Learn more &rarr;</span></a>)}</div>
  </div></section>
  <section class="sec sec-white"><div class="sec-in split">
    <div>
      <span class="sec-kicker">Local housing</span>
      <h2 class="sec-title">{home.housingTitle}</h2>
      <p class="sec-lead" style="margin:0">{home.housingLead}</p>
      <div class="callout-box"><p set:html={home.housingBox} /></div>
    </div>
    <div class="lb-list">{neighborhoods.map((n) => <a class="lb" href={u(`/neighborhood/${n.slug}/`)}><h3>{n.name}</h3><p>{n.intro}</p></a>)}</div>
  </div></section>
  <section class="sec sec-low"><div class="sec-in">
    <span class="sec-kicker">Process</span>
    <h2 class="sec-title">{home.stepsTitle ?? 'From symptoms to a sensible next step'}</h2>
    <div class="steps">{steps.map((s, i) => <div class="step"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div>
  </div></section>
  <section class="sec sec-white"><div class="sec-in">
    <h2 class="sec-title">{home.faqHeading}</h2>
    <div class="faq">{home.faqs.map((f) => <article><h3>{f.q}</h3><p set:html={f.a} /></article>)}</div>
  </div></section>
  <Callout title={home.calloutTitle} text={home.calloutText} />
  <section class="sec sec-cream"><div class="sec-in">
    <span class="sec-kicker">Coverage</span>
    <h2 class="sec-title">{home.coverageTitle}</h2>
    <p class="sec-lead">{home.coverageLead}</p>
    <div class="pill-grid">{neighborhoods.map((n) => <a class="pill" href={u(`/neighborhood/${n.slug}/`)}>{n.name}</a>)}</div>
  </div></section>
<section class="nh-body"><div class="nh-inner"><p set:html={home.footerLinksHtml.replace(/href="(\/[^"]*)"/g, (_m, h) => 'href="' + u(h) + '"')} /></div></section>
</Base>
