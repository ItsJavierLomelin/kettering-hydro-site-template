---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Callout from '../../components/Callout.astro';
import { city, neighborhoods } from '../../data/city';
import { u } from '../../lib/utils';
const c = city.indexPages.neighborhoods;
---
<Base title={c.title} description={c.desc} path="/neighborhood/" crumbs={[{ name: 'Neighborhoods', path: '/neighborhood/' }]}>
  <Hero headline={c.h1} intro={c.intro} location="Neighborhoods" crumbs={[{ href: '/neighborhood/', label: 'Neighborhoods' }]} />
  <section class="sec sec-cream"><div class="sec-in">
    <div class="svc-grid">{neighborhoods.map((n) => <a class="svc" href={u(`/neighborhood/${n.slug}/`)}><span class="eb">Neighborhood</span><h3>{n.name}</h3><p>{n.intro}</p><span class="arrow">Read more &rarr;</span></a>)}</div>
  </div></section>
  <Callout />
</Base>
